{
  "$schema":"https://schema.tauri.app/config/2",
  "productName":"CueRithm",
  "version":"0.1.0",
  "identifier":"com.cuerithm.app",
  "build":{
    "beforeDevCommand":"pnpm dev",
    "devUrl":"http://127.0.0.1:1420",
    "beforeBuildCommand":"pnpm build",
    "frontendDist":"../dist"
  },
  "app":{
    "windows":[{"label":"main","title":"CueRithm","width":1440,"height":940,"minWidth":980,"minHeight":680,"backgroundColor":"#10121B","titleBarStyle":"Overlay","hiddenTitle":true}],
    "security":{"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost 'self'","devCsp":null}
  },
  "bundle":{
    "active":true,
    "icon":["icons/32x32.png","icons/128x128.png","icons/icon.icns","icons/icon.ico"],
    "resources":{"../../../tools/media-runtime/bin/":"media/"}
  }
}
